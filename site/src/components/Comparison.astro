---
import { withGut, withoutGut } from '../lib/code.ts';
import Silhouette from './Silhouette.astro';

const EXAMPLES = 'https://github.com/fishballapp/gut/blob/main/examples';
---

<section aria-labelledby="race-title" class="border-t border-line">
  <div class="mx-auto grid max-w-6xl gap-10 px-5 py-20 sm:px-8 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16 lg:py-24">
    <div>
      <h2 id="race-title" class="text-3xl font-semibold tracking-tight text-balance sm:text-4xl">
        The wiki race in {withGut.length} lines. Without gut, {withoutGut.length}.
      </h2>
      <p class="mt-5 max-w-[60ch] text-muted">
        <a href="#story" class="text-ink underline decoration-line hover:decoration-ink">The task above</a>{' '}
        is its core. The same race written straight against a decision model's SDK spells out the
        bundles, the split on refusal, the budget and the log.
      </p>
    </div>

    <figure>
      <div class="grid grid-cols-2 gap-6 sm:gap-10">
        <div>
          <p class="font-mono text-[12px] text-muted">
            with gut <span class="block text-ink">{withGut.length} lines</span>
          </p>
          <div class="mt-3"><Silhouette lines={withGut} tone="mark" /></div>
        </div>
        <div>
          <p class="font-mono text-[12px] text-muted">
            without <span class="block text-ink">{withoutGut.length} lines</span>
          </p>
          <div class="mt-3"><Silhouette lines={withoutGut} tone="block" /></div>
        </div>
      </div>
      <figcaption class="mt-5 text-[13px] text-muted">
        Each bar is a line, at one scale. With gut:{' '}
        <a href={`${EXAMPLES}/wikirace.gut.ts`} class="text-ink underline decoration-line hover:decoration-ink">wikirace.gut.ts</a>.
        Without:{' '}
        <a href={`${EXAMPLES}/wikirace.plain.ts`} class="text-ink underline decoration-line hover:decoration-ink">wikirace.plain.ts</a>, on TypeSafe's SDK.
      </figcaption>
    </figure>
  </div>
</section>
