---
import CopyCommand from './CopyCommand.astro';
import Icon from './Icon.astro';

const README = 'https://github.com/fishballapp/gut';
---

<section id="start" aria-labelledby="start-title" class="border-t border-line">
  <div class="mx-auto grid max-w-6xl gap-10 px-5 py-20 sm:px-8 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16 lg:py-24">
    <div>
      <h2 id="start-title" class="text-3xl font-semibold tracking-tight text-balance sm:text-4xl">
        Get started
      </h2>
      <p class="mt-5 max-w-[56ch] text-muted">
        Try a task with no model first, answering each pick yourself in the inspector. Then point it
        at Jev (hosted, through OpenRouter), Clef on a local Ollama, or any{' '}
        <code class="font-mono text-[0.9em] text-ink">/v1/systemone</code> endpoint.
      </p>
    </div>
    <div class="min-w-0 self-end">
      <CopyCommand
        command="npm install @gut.run/core && npm install --global @gut.run/cli"
        label="Copy the install command"
      />
      <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-4">
        <a
          href={`${README}#try-it`}
          class="inline-flex h-10 items-center gap-1.5 rounded-md bg-ink px-4 text-[14px] font-medium text-ground transition-opacity hover:opacity-90"
        >
          Try it with no model <Icon name="arrowUpRight" />
        </a>
        <a
          href={`${README}#a-task`}
          class="inline-flex items-center gap-1 text-[14px] font-medium underline decoration-line underline-offset-4 hover:decoration-ink"
        >
          Write your own task <Icon name="arrowUpRight" size={12} />
        </a>
      </div>
    </div>
  </div>
</section>
