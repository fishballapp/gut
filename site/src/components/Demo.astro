---
import { race } from '../lib/race.ts';
import Icon from './Icon.astro';

const format = new Intl.NumberFormat('en');
---

<section id="demo" aria-labelledby="demo-title" class="border-t border-line">
  <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8 lg:py-24">
    <div class="flex flex-wrap items-end justify-between gap-x-10 gap-y-5">
      <div class="max-w-2xl">
        <h2 id="demo-title" class="text-3xl font-semibold tracking-tight text-balance sm:text-4xl">
          See why it picked what it picked.
        </h2>
        <p class="mt-5 text-muted">
          The race above, replayed in gut’s inspector: {race.rounds.length} rounds,{' '}
          {race.requests} requests and {format.format(race.inputTokens)} input tokens to{' '}
          {race.model} on a laptop. Open any turn to read what the model read, and the probability it
          gave each option.
        </p>
      </div>
      <div class="flex items-center gap-2">
        <a
          href="/demo/"
          class="inline-flex h-8 items-center gap-1.5 rounded-md border border-line bg-raised px-3 text-[13px] font-medium transition-colors hover:border-ink/40"
        >
          Open full screen <Icon name="arrowUpRight" size={12} />
        </a>
        <button
          type="button"
          data-replay
          class="inline-flex h-8 items-center gap-1.5 rounded-md border border-line bg-raised px-3 text-[13px] font-medium transition-colors hover:border-ink/40"
        >
          <Icon name="replay" />
          Replay
        </button>
      </div>
    </div>

    <div class="mt-8 overflow-hidden rounded-lg border border-line bg-ground shadow-[0_24px_48px_-24px_oklch(0.2_0.01_90/0.25)]">
      <iframe
        data-replay-frame
        src="/demo/index.html"
        title={`The gut inspector replaying ${race.name} on ${race.model}`}
        loading="lazy"
        class="block h-[70svh] max-h-[680px] min-h-[520px] w-full"></iframe>
    </div>
  </div>
</section>
