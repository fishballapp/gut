---
import { race } from '../lib/race.ts';
import Icon from './Icon.astro';

const format = new Intl.NumberFormat('en');

// Only what was measured: the README's figures, and the recorded race on this page.
const FACTS = [
  {
    value: '255 ms',
    text: `median time per request to Jev, TypeSafe's decision model, on OpenRouter, over 124 requests (p90 330 ms; measured 2026-10-05). A request is one turn, not a task: the picks in the race above took ${race.requestsPerPick.min} or ${race.requestsPerPick.max} turns each.`,
  },
  {
    value: '42/42',
    text: "browser bench runs on Jev at each question size, up to 255 options and up to 26: local fixture sites, Wikipedia, Hacker News, GitHub and saucedemo, 3 runs each (measured 2026-10-09). None ended claiming a goal that wasn't met. arXiv, run the same way, went 0 of 3.",
  },
  {
    value: format.format(race.inputTokens),
    text: `input tokens for the race above: ${race.requests} requests to ${race.model} on a laptop, over ${race.rounds.length} rounds.`,
  },
];
---

<section aria-labelledby="measured-title" class="border-t border-line">
  <div class="mx-auto grid max-w-6xl gap-10 px-5 py-20 sm:px-8 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16 lg:py-24">
    <div>
      <h2 id="measured-title" class="text-3xl font-semibold tracking-tight text-balance sm:text-4xl">
        Measured runs. Bounded execution.
      </h2>
      <p class="mt-5 max-w-[50ch] text-muted">
        Every run has an input-token budget, stops when the same view brings the same pick three
        times, and ends with a result that says its outcome, input tokens and request count.
      </p>
      <a
        href="https://github.com/fishballapp/gut#how-it-does"
        class="mt-6 inline-flex items-center gap-1 text-[13px] font-medium underline decoration-line hover:decoration-ink"
      >
        How the bench was run <Icon name="arrowUpRight" size={12} />
      </a>
    </div>
    <dl class="divide-y divide-line border-y border-line">
      {
        FACTS.map(({ value, text }) => (
          <div class="grid gap-x-8 gap-y-1 py-5 sm:grid-cols-[9rem_minmax(0,1fr)]">
            <dt class="font-mono text-xl font-medium tracking-tight">{value}</dt>
            <dd class="text-muted">{text}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
