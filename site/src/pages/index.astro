---
import Comparison from '../components/Comparison.astro';
import Demo from '../components/Demo.astro';
import Flowchart from '../components/Flowchart.astro';
import GetStarted from '../components/GetStarted.astro';
import GutBackground from '../components/GutBackground.astro';
import Icon from '../components/Icon.astro';
import Measured from '../components/Measured.astro';
import Models from '../components/Models.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Story from '../components/Story.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <GutBackground />
  <SiteHeader />
  <main class="isolate">
    <section class="mx-auto max-w-6xl px-5 pt-14 pb-12 sm:px-8 sm:pt-20 lg:pb-14">
      <p class="font-mono text-[13px] text-muted">
        The open-source TypeScript framework for System&nbsp;1 models
      </p>
      <h1
        class="mt-4 text-[clamp(2.75rem,7vw,5rem)] leading-[0.98] font-semibold tracking-[-0.035em] text-balance"
      >
        <span class="sm:block">Agents think too much.</span>{' '}
        <span class="sm:block">Give them <span class="marked marked-stroke">a&nbsp;gut.</span></span>
      </h1>
      <p class="mt-8 max-w-[58ch] text-[17px] leading-relaxed text-muted">
        Write the moves in TypeScript. gut runs the loop while a fast decision model picks the next
        move, round by round, until the goal is met. The model only picks; it never generates text.
      </p>
      <div class="mt-9 flex flex-wrap items-center gap-x-6 gap-y-4">
        <a
          href="#start"
          class="inline-flex h-10 items-center rounded-md bg-ink px-4 text-[14px] font-medium text-ground transition-opacity hover:opacity-90"
        >
          Get started
        </a>
        <a
          href="https://github.com/fishballapp/gut#readme"
          class="inline-flex items-center gap-1 text-[14px] font-medium underline decoration-line underline-offset-4 hover:decoration-ink"
        >
          Read the docs <Icon name="arrowUpRight" size={12} />
        </a>
        <a
          href="https://github.com/fishballapp/gut"
          class="inline-flex items-center gap-1 text-[14px] font-medium underline decoration-line underline-offset-4 hover:decoration-ink"
        >
          GitHub <Icon name="arrowUpRight" size={12} />
        </a>
        <p class="font-mono text-[12px] text-muted">Free · MIT licensed</p>
      </div>
    </section>

    <Story />

    <div class="border-t border-line pt-20 lg:pt-24">
      <Demo />
    </div>

    <div class="mt-20 lg:mt-28">
      <Models />
      <Flowchart />
      <Comparison />
      <Measured />
      <GetStarted />
    </div>
  </main>
  <SiteFooter />
</Layout>

<script>
  // Bundled, not is:inline, so it can import captureIfDecided (skips while consent is undecided).
  import { captureIfDecided } from '@fishballapps/marketing/posthog';

  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    button.addEventListener('click', async () => {
      const command = button.dataset.copy ?? '';
      await navigator.clipboard.writeText(command);
      captureIfDecided('command_copied', { command });
      button.dataset.copied = '';
      setTimeout(() => delete button.dataset.copied, 1600);
    });
  }

  const frame = document.querySelector<HTMLIFrameElement>('[data-replay-frame]');
  document
    .querySelector('[data-replay]')
    ?.addEventListener('click', () => frame?.contentWindow?.location.reload());
</script>
