{
  "name": "@gut.run/core",
  "version": "0.2.0",
  "type": "module",
  "description": "A non-deterministic runtime: you write the moves, a decision model writes the order.",
  "license": "MIT",
  "homepage": "https://github.com/fishballapp/gut",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fishballapp/gut.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts",
    "prepack": "pnpm build",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "type-fest": "catalog:",
    "vitest": "catalog:"
  }
}
